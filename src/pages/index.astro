---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { posts } from '../lib/posts';
const entries = await posts();
---
<Base>
  <section class="section-block">
    <div class="section-heading"><h1>Recent Posts</h1><nav class="section-links" aria-label="記事のジャンル"><a href="/posts/">Diary →</a><a href="/tech/">Tech →</a></nav></div>
    {entries.length ? <PostList entries={entries.slice(0, 5)} featured showCategory /> : <p class="empty">記事はまだありません。</p>}
  </section>
</Base>
