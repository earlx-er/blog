---
import Base from '../../layouts/Base.astro';
import PostArchive from '../../components/PostArchive.astro';
import { posts } from '../../lib/posts';
import { postsPerPage } from '../../lib/post-archive.mjs';
const entries = (await posts()).filter(post => post.data.category === 'tech');
---
<Base title="Tech" ogImage="/og/pages/tech.png">
  <h1 class="sr-only">Tech</h1>
  <PostArchive entries={entries.slice(0, postsPerPage)} currentPage={1} lastPage={Math.max(1, Math.ceil(entries.length / postsPerPage))} sectionPath="/tech/" />
</Base>
