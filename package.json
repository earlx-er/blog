{
  "name": "earlx-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/build-search.mjs dist",
    "build:preview": "SITE_PREVIEW=1 astro build --outDir dist-preview && node scripts/build-search.mjs dist-preview && node scripts/build-design-proposals.mjs && node scripts/build-og-proposals.mjs && node scripts/build-og-references.mjs",
    "preview": "astro preview --host 127.0.0.1 --outDir dist-preview",
    "import:obsidian": "node scripts/import-obsidian.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.0",
    "astro": "^7.3.4",
    "gray-matter": "^4.0.3",
    "sharp": "^0.35.4",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.0"
  }
}
